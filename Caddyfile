:80 {
    handle /nct-lab-root.crt {
        header Content-Disposition "attachment; filename=Network-Characterization-Tool-Lab-CA.crt"
        header Content-Type "application/x-x509-ca-cert"
        root * /srv/certs
        file_server
    }
    handle {
        redir https://{host}{uri} permanent
    }
}

:443 {
    tls /etc/caddy/tls/nct-server.crt /etc/caddy/tls/nct-server.key
    reverse_proxy analyzer:8080
}
